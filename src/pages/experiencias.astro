---
import StaticPage from "../layouts/StaticPage.astro";
import { readStaticPage } from "../lib/html.js";
import { fetchSanity, urlForImage } from "../lib/sanity.js";

const page = readStaticPage("experiencias.html");

const [occasionalWorkshops, experiences, trustedBrands] = await Promise.all([
  fetchSanity(
    `*[_type == "occasionalWorkshop" && isPublished == true] | order(coalesce(date, "9999-12-31") asc, _createdAt desc)[0...6]{
      title,
      summary,
      date,
      ageRange,
      schedule,
      price,
      image,
      venue->{name}
    }`,
  ),
  fetchSanity(
    `*[_type == "experience" && isPublished == true] | order(isFeatured desc, coalesce(eventDate, "9999-12-31") asc, _createdAt desc)[0...8]{
      title,
      category,
      summary,
      eventDate,
      image
    }`,
  ),
  fetchSanity(
    `*[_type == "brand" && isPublished == true] | order(order asc, name asc)[0...12]{
      name,
      website,
      logo
    }`,
  ),
]);

function escapeHtml(value = "") {
  return String(value)
    .replaceAll("&", "&amp;")
    .replaceAll("<", "&lt;")
    .replaceAll(">", "&gt;")
    .replaceAll('"', "&quot;")
    .replaceAll("'", "&#039;");
}

function formatDate(value) {
  if (!value) return "";
  return new Intl.DateTimeFormat("es-AR", {
    day: "numeric",
    month: "long",
    year: "numeric",
  }).format(new Date(`${value}T00:00:00`));
}

function renderWorkshopCard(workshop) {
  const imageUrl = urlForImage(workshop.image)?.width(900).height(620).fit("crop").auto("format").url();
  const meta = [
    formatDate(workshop.date),
    workshop.venue?.name,
    workshop.schedule,
    workshop.ageRange,
    workshop.price,
  ].filter(Boolean);

  return `
    <article class="cms-card reveal">
      ${
        imageUrl
          ? `<img src="${escapeHtml(imageUrl)}" alt="${escapeHtml(workshop.title)}" loading="lazy" />`
          : ""
      }
      <div>
        <h3>${escapeHtml(workshop.title)}</h3>
        ${workshop.summary ? `<p>${escapeHtml(workshop.summary)}</p>` : ""}
        ${meta.length ? `<div class="cms-meta">${meta.map((item) => `<span>${escapeHtml(item)}</span>`).join("")}</div>` : ""}
      </div>
    </article>
  `;
}

function renderExperienceCard(experience) {
  const imageUrl = urlForImage(experience.image)?.width(900).height(620).fit("crop").auto("format").url();
  const meta = [categoryLabels[experience.category], formatDate(experience.eventDate)].filter(Boolean);

  return `
    <article class="cms-card reveal">
      ${
        imageUrl
          ? `<img src="${escapeHtml(imageUrl)}" alt="${escapeHtml(experience.title)}" loading="lazy" />`
          : ""
      }
      <div>
        <h3>${escapeHtml(experience.title)}</h3>
        ${experience.summary ? `<p>${escapeHtml(experience.summary)}</p>` : ""}
        ${meta.length ? `<div class="cms-meta">${meta.map((item) => `<span>${escapeHtml(item)}</span>`).join("")}</div>` : ""}
      </div>
    </article>
  `;
}

function renderBrandCard(brand) {
  const logoUrl = urlForImage(brand.logo)?.width(640).height(420).fit("max").auto("format").url();
  const content = `
    <span class="brand-media">
      ${
        logoUrl
          ? `<img src="${escapeHtml(logoUrl)}" alt="${escapeHtml(brand.name)}" loading="lazy" />`
          : `<span class="brand-placeholder">${escapeHtml(brand.name.slice(0, 2).toUpperCase())}</span>`
      }
    </span>
    <span class="brand-copy">
      <strong>${escapeHtml(brand.name)}</strong>
      ${brand.website ? `<small>Ver sitio →</small>` : `<small>Marca aliada</small>`}
    </span>
  `;

  if (brand.website) {
    return `<a class="brand-card reveal" href="${escapeHtml(brand.website)}" target="_blank" rel="noreferrer">${content}</a>`;
  }

  return `<div class="brand-card reveal">${content}</div>`;
}

function replaceSection(body, startMarker, replacement) {
  const startIndex = body.indexOf(startMarker);
  if (startIndex === -1) return body;

  const endIndex = body.indexOf("</section>", startIndex);
  if (endIndex === -1) return body;

  return `${body.slice(0, startIndex)}${replacement}${body.slice(endIndex + "</section>".length)}`;
}

const categoryLabels = {
  competition: "Competencia",
  event: "Evento",
  school: "Escuela",
  company: "Empresa",
  birthday: "Cumple Robotiki",
  seasonal: "Fecha especial",
};

const dynamicExperiencesSection = experiences.length
  ? `
      <section class="section cms-section">
        <div class="section-heading reveal">
          <p class="eyebrow">Experiencias</p>
          <h2>Propuestas especiales para distintos contextos</h2>
        </div>
        <div class="cms-grid stagger">
          ${experiences.map(renderExperienceCard).join("")}
        </div>
      </section>
    `
  : "";

const cmsSections = [
  occasionalWorkshops.length
    ? `
      <section class="section cms-section">
        <div class="section-heading reveal">
          <p class="eyebrow">Talleres ocasionales</p>
          <h2>Próximas propuestas especiales</h2>
        </div>
        <div class="cms-grid stagger">
          ${occasionalWorkshops.map(renderWorkshopCard).join("")}
        </div>
      </section>
    `
    : "",
  trustedBrands.length
    ? `
      <section class="section cms-section">
        <div class="section-heading reveal">
          <p class="eyebrow">Marcas que confían</p>
          <h2>Instituciones y empresas que viven Robotiki</h2>
        </div>
        <div class="brand-grid stagger">
          ${trustedBrands.map(renderBrandCard).join("")}
        </div>
      </section>
    `
    : "",
]
  .filter(Boolean)
  .join("");

const bodyWithExperiences = dynamicExperiencesSection
  ? replaceSection(page.body, '<section class="section features">', dynamicExperiencesSection)
  : page.body;

const body = cmsSections
  ? bodyWithExperiences.replace('<section class="section final-cta reveal">', `${cmsSections}<section class="section final-cta reveal">`)
  : bodyWithExperiences;
---

<StaticPage {...page} body={body} />
