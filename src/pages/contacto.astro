---
import StaticPage from "../layouts/StaticPage.astro";
import { readStaticPage } from "../lib/html.js";
import { fetchSanity } from "../lib/sanity.js";

const page = readStaticPage("contacto.html");

const [venues, schedules] = await Promise.all([
  fetchSanity(
    `*[_type == "venue" && isPublished == true] | order(name asc){
      name,
      zone,
      address,
      mapUrl,
      whatsapp
    }`,
  ),
  fetchSanity(
    `*[_type == "schedule" && isPublished == true] | order(level asc, venue->name asc, day asc, time asc){
      level,
      day,
      time,
      notes,
      venue->{name, zone, address, mapUrl}
    }`,
  ),
]);

function escapeHtml(value = "") {
  return String(value)
    .replaceAll("&", "&amp;")
    .replaceAll("<", "&lt;")
    .replaceAll(">", "&gt;")
    .replaceAll('"', "&quot;")
    .replaceAll("'", "&#039;");
}

function replaceSection(body, startMarker, replacement) {
  const startIndex = body.indexOf(startMarker);
  if (startIndex === -1) return body;

  const endIndex = body.indexOf("</section>", startIndex);
  if (endIndex === -1) return body;

  return `${body.slice(0, startIndex)}${replacement}${body.slice(endIndex + "</section>".length)}`;
}

function renderVenueCard(venue) {
  const details = venue.address || venue.zone;
  const content = `
    <span></span>
    <div>
      <h3>${escapeHtml(venue.name)}</h3>
      ${details ? `<p>${escapeHtml(details)}</p>` : ""}
    </div>
  `;

  if (venue.mapUrl) {
    return `<a class="sede-card reveal" href="${escapeHtml(venue.mapUrl)}" target="_blank" rel="noreferrer">${content}</a>`;
  }

  return `<article class="sede-card reveal">${content}</article>`;
}

function normalizeText(value = "") {
  return String(value)
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .toLowerCase();
}

const mapPins = [
  {label: "Belgrano", matches: ["belgrano", "monroe"], x: "39%", y: "49%"},
  {label: "Vicente López", matches: ["vicente lopez", "libertador"], x: "42%", y: "34%"},
  {label: "Boulogne / San Isidro", matches: ["boulogne", "san isidro", "guayaquil"], x: "25%", y: "23%"},
  {label: "Villa Devoto", matches: ["villa devoto", "devoto", "salvador maria del carril"], x: "44%", y: "75%"},
  {label: "Villa Ballester", matches: ["villa ballester", "ballester", "lacroze"], x: "29%", y: "42%"},
];

function findVenueForPin(pin) {
  return venues.find((venue) => {
    const searchable = normalizeText([venue.name, venue.zone, venue.address].filter(Boolean).join(" "));
    return pin.matches.some((match) => searchable.includes(match));
  });
}

function fallbackMapUrl(label) {
  return `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${label} Robotiki`)}`;
}

function renderMapPin(pin) {
  const venue = findVenueForPin(pin);
  const label = venue?.name || pin.label;
  const href = venue?.mapUrl || fallbackMapUrl(label);
  const ariaLabel = venue?.address
    ? `Abrir ${label}, ${venue.address}, en Google Maps`
    : `Abrir ${label} en Google Maps`;

  return `
    <a class="map-pin-link" style="--pin-x: ${pin.x}; --pin-y: ${pin.y};" href="${escapeHtml(href)}" target="_blank" rel="noreferrer" aria-label="${escapeHtml(ariaLabel)}">
      <span class="map-pin-dot" aria-hidden="true"></span>
      <span class="map-pin-label">${escapeHtml(label)}</span>
    </a>
  `;
}

function renderMapTiles() {
  const rows = [1232, 1233, 1234];
  const columns = [689, 690, 691, 692];

  return rows
    .flatMap((y) =>
      columns.map(
        (x) =>
          `<img class="venues-map-tile" src="https://tile.openstreetmap.org/11/${x}/${y}.png" alt="" loading="lazy" aria-hidden="true" />`,
      ),
    )
    .join("");
}

function renderVenuesMap() {
  return `
    <figure class="venues-map reveal" aria-label="Mapa real de sedes Robotiki">
      <div class="venues-map-frame">
        <div class="venues-map-tiles" role="img" aria-label="Mapa de CABA y GBA Norte con sedes Robotiki">
          ${renderMapTiles()}
        </div>
        ${mapPins.map(renderMapPin).join("")}
      </div>
    </figure>
  `;
}

function renderScheduleItem(item) {
  const venueName = item.venue?.name || "Sede";
  const address = item.venue?.address;
  const mapUrl = item.venue?.mapUrl;
  const timing = [item.day, item.time].filter(Boolean).join(" ");
  const notes = item.notes ? ` ${item.notes}` : "";
  const scheduleText = escapeHtml(`${timing}${notes}`.trim());
  const venueLabel = address ? `${venueName} - ${address}` : venueName;
  const venueMarkup = mapUrl
    ? `<a class="schedule-map-link" href="${escapeHtml(mapUrl)}" target="_blank" rel="noreferrer">${escapeHtml(venueLabel)}</a>`
    : `<strong>${escapeHtml(venueLabel)}</strong>`;

  return `<p>${venueMarkup}${scheduleText ? `: ${scheduleText}` : ""}</p>`;
}

function renderScheduleCard([level, items]) {
  return `
    <article class="schedule-card reveal">
      <h3>${escapeHtml(level)}</h3>
      ${items.map(renderScheduleItem).join("")}
    </article>
  `;
}

const venuesSection = venues.length
  ? `
      <section class="section sedes" id="sedes">
        <div class="section-heading reveal">
          <p class="eyebrow">Sedes Robotiki</p>
          <h2>Estamos presentes en distintas zonas</h2>
        </div>
        <div class="venues-layout">
          <div class="sedes-grid stagger">
            ${venues.map(renderVenueCard).join("")}
          </div>
          ${renderVenuesMap()}
        </div>
      </section>
    `
  : "";

const schedulesByLevel = schedules.reduce((groups, schedule) => {
  const level = schedule.level || "Horarios";
  if (!groups.has(level)) groups.set(level, []);
  groups.get(level).push(schedule);
  return groups;
}, new Map());

const schedulesSection = schedules.length
  ? `
      <section class="section">
        <div class="section-heading reveal">
          <p class="eyebrow">Horarios orientativos</p>
          <h2>Talleres por sede y nivel</h2>
        </div>
        <div class="schedule-grid stagger">
          ${Array.from(schedulesByLevel.entries()).map(renderScheduleCard).join("")}
        </div>
      </section>
    `
  : "";

const bodyWithVenues = venuesSection
  ? replaceSection(page.body, '<section class="section sedes" id="sedes">', venuesSection)
  : page.body;

const body = schedulesSection
  ? replaceSection(
      bodyWithVenues,
      `<section class="section">
        <div class="section-heading reveal">
          <p class="eyebrow">Horarios orientativos</p>`,
      schedulesSection,
    )
  : bodyWithVenues;
---

<StaticPage {...page} body={body} />
