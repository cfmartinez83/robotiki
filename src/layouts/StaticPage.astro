---
import Analytics from "@vercel/analytics/astro";
import { fetchSanity } from "../lib/sanity.js";

const { title, description, bodyClass = "", body } = Astro.props;
const siteSettings = await fetchSanity(
  `*[_id == "8d0d7882-84ff-4b1a-afe5-9a69c9e16858"][0]{
    tagline,
    whatsapp,
    whatsappLabel,
    email,
    secondaryEmail,
    address,
    businessHours,
    primaryCtaLabel,
    copyright
  }`,
  {},
  null,
);

function escapeHtml(value = "") {
  return String(value)
    .replaceAll("&", "&amp;")
    .replaceAll("<", "&lt;")
    .replaceAll(">", "&gt;")
    .replaceAll('"', "&quot;")
    .replaceAll("'", "&#039;");
}

function replaceAll(value, replacements) {
  return replacements.reduce((current, [search, replacement]) => {
    if (!replacement) return current;
    return current.replaceAll(search, escapeHtml(replacement));
  }, value);
}

const whatsappNumber = siteSettings?.whatsapp?.replace(/\D/g, "");
const bodyWithSettings = replaceAll(body, [
  ["Robotiki - imagina tu futuro", siteSettings?.tagline],
  ["info@robotiki.com.ar", siteSettings?.email],
  ["robotikiar@gmail.com", siteSettings?.secondaryEmail],
  ["+54 9 11 3391-7070", siteSettings?.whatsappLabel],
  ["5491133917070", whatsappNumber],
  ["Av. Libertador 747, Vicente López", siteSettings?.address],
  ["Lunes a viernes de 9:00 a 20:00 hs.", siteSettings?.businessHours],
  ["¡Quiero probar!", siteSettings?.primaryCtaLabel],
  ["© 2026 Robotiki. Hecho con imaginación, código y robots.", siteSettings?.copyright],
]);

const bodyWithLegalLinks = bodyWithSettings.replace(
  `      <nav aria-label="Links de footer">
        <a href="./talleres.html">Talleres</a>
        <a href="./experiencias.html">Experiencias</a>
        <a href="./contacto.html">Sedes y contacto</a>
        <a href="./jugar.html">Robot DJ</a>
      </nav>`,
  `      <nav aria-label="Links de footer">
        <a href="./talleres.html">Talleres</a>
        <a href="./experiencias.html">Experiencias</a>
        <a href="./contacto.html">Sedes y contacto</a>
        <a href="./jugar.html">Robot DJ</a>
        <a href="./privacidad.html">Privacidad</a>
        <a href="./terminos.html">Términos</a>
      </nav>`,
);
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {description && <meta name="description" content={description} />}
    <meta name="theme-color" content="#0d0221" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Nunito:wght@700;800;900&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="./styles.css" />
    <Analytics />
  </head>
  <body class={bodyClass} set:html={bodyWithLegalLinks}></body>
</html>
