{
  "name": "robotiki",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "vercel-build": "if [ -n \"$SANITY_AUTH_TOKEN\" ]; then npm run sanity:schema:deploy; else echo \"Skipping Sanity schema deploy: SANITY_AUTH_TOKEN is not set\"; fi && astro build",
    "preview": "astro preview",
    "sanity:dev": "sanity dev --host 0.0.0.0",
    "sanity:deploy": "sanity deploy",
    "sanity:schema:deploy": "sanity schema deploy"
  },
  "devDependencies": {
    "astro": "^6.3.8"
  },
  "dependencies": {
    "@astrojs/react": "^5.0.5",
    "@sanity/astro": "^3.4.0",
    "@sanity/client": "^7.22.0",
    "@sanity/image-url": "^2.1.1",
    "@sanity/vision": "^5.27.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "sanity": "^5.27.0"
  }
}
